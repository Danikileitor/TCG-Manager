# Copia este archivo como ".env" para desarrollo local (netlify dev).
# En producción NO se sube nada: define estas variables en
# Netlify -> Site configuration -> Environment variables (marcadas como "secret").

MONGODB_URI=mongodb+srv://USUARIO_APP:CONTRASENA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tcgmanager
# ID de cliente OAuth de Google (Google Cloud Console). Es público, NO lleva "client secret".
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
JWT_SECRET=pon_aqui_una_cadena_larga_y_aleatoria_de_64_caracteres_o_mas
